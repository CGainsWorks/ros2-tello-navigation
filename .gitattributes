# Normalise line endings so the repository behaves the same on Linux and on
# Windows. The whole toolchain is developed on both.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.msg       text eol=lf

# Explicitly binary. `text=auto` above already auto-detects these, so this is
# belt and braces: a figure silently line-ending-normalised is a corrupt PNG
# that still renders in the diff as a one line change.
*.png       -text
*.jpg       -text

# ---------------------------------------------------------------------------
# Git LFS. Anything below is large, binary, or both, and must never enter the
# ordinary Git history.
# ---------------------------------------------------------------------------

# Recorded flights
*.bag       filter=lfs diff=lfs merge=lfs -text
*.db3       filter=lfs diff=lfs merge=lfs -text
*.mcap      filter=lfs diff=lfs merge=lfs -text
*.npz       filter=lfs diff=lfs merge=lfs -text

# Media
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.avi       filter=lfs diff=lfs merge=lfs -text
*.gif       filter=lfs diff=lfs merge=lfs -text

# NOT LFS: the figures under docs/figures/ and analysis/figures/. They are
# regenerated by `make figures` from committed CSV, they are a few tens of
# kilobytes each, and a clone without git-lfs installed would otherwise show
# pointer files where the README's diagram should be. A README whose first
# image is broken on a fresh clone is worse than a slightly larger history.
