<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tello_control</name>
  <version>0.1.0</version>
  <description>
    The PID waypoint controller and the failsafe state machine, in one node so that a failsafe veto is a function call rather than a topic.
  </description>
  <maintainer email="114424105+CGainsWorks@users.noreply.github.com">CGainsWorks</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tello_msgs</exec_depend>
  <exec_depend>tello_core</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
